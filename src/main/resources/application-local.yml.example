# MẪU cấu hình cho profile `local`.
# Cách dùng: copy file này thành application-local.yml (cùng thư mục) rồi điền giá trị thật.
# application-local.yml đã nằm trong .gitignore -> KHÔNG commit.

spring:
  mail:
    username: your_gmail@gmail.com
    password: your_app_password
  datasource:
    url: jdbc:mysql://localhost:3306/starshop?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
    username: root
    password: your_mysql_password

  jpa:
    show-sql: true

# JWT: chuỗi ngẫu nhiên >= 32 ký tự. Tạo nhanh: python -c "import secrets;print(secrets.token_urlsafe(48))"
jwt:
  secret: change_me_to_a_random_string_at_least_32_chars

# Email (Gmail: bật xác minh 2 bước -> Tài khoản Google -> Bảo mật -> Mật khẩu ứng dụng)
#  spring.mail.username / password; nếu để trống thì bật dev-log-otp để xem OTP trong console
app:
  mail:
    dev-log-otp: true

# Cloudinary (đăng ký miễn phí tại cloudinary.com -> Dashboard -> API Keys)
cloudinary:
  cloud-name: your_cloud_name
  api-key: your_api_key
  api-secret: your_api_secret

server:
  servlet:
    jsp:
      init-parameters:
        # Tự biên dịch lại JSP khi sửa file (chỉ dùng khi dev)
        development: true
